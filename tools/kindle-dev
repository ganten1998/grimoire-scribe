#!/bin/sh
# kindle-dev: build a separate "Grimoire (dev)" and copy it to a Kindle over MTP.
#
#   make dev
#   tools/kindle-dev --mount /run/user/1000/gvfs/mtp:host=...
#
# It builds build/dist/Grimoire.zip (make package), takes its self-contained
# documents/Grimoire.sh, renames the Library entry to "Grimoire (dev)" and gives it its own data
# root (/mnt/us/dev/grimoire), then copies it to the Kindle's documents folder as
# "Grimoire (dev).sh" over MTP. The released Grimoire and its notebooks in /mnt/us/grimoire are
# never touched, so both Library items can coexist.
#
# MTP cannot start the app: close Grimoire (dev) if it is open, then tap it in the Library.
#
# Environment:
#   GRIMOIRE_MTP_MOUNT  mounted Kindle folder holding documents, if auto-detection misses it
#   ZIG                 Zig 0.16.0 for make package (default: zig on PATH)
#   BUILD               make's build folder (default: build)
set -eu

HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
MOUNT=${GRIMOIRE_MTP_MOUNT:-}
NAME="Grimoire (dev)"
DEV_ROOT=/mnt/us/dev
BUILD_IT=1
ZIP=

usage() {
    cat <<'EOF'
kindle-dev: build a separate Grimoire (dev) and copy it to a Kindle over MTP.

  make dev                 build and copy with the defaults

Options:
  --mount PATH   the mounted Kindle folder that holds documents
  --name NAME    the Library entry and launcher name (default: "Grimoire (dev)")
  --root PATH    the dev data root on the Kindle (default: /mnt/us/dev)
  --no-build     use the existing build/dist/Grimoire.zip
  --zip PATH     use another installer zip (make dist, or a release download)
  -h, --help     this text

The Scribe must be in USB file transfer (MTP) mode, unlocked, with Allow tapped if it asks.
On Linux the script tries a mounted MTP volume first (gio mount mtp://); otherwise pass
--mount or set GRIMOIRE_MTP_MOUNT to the folder holding documents. The release's
documents/Grimoire.sh and /mnt/us/grimoire are never touched.

MTP cannot launch an app: close Grimoire (dev) if it is open, then tap "Grimoire (dev)" in the
Library. Its first launch unpacks into the dev data root; notebooks and settings there are
separate from the release's.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
    --mount) MOUNT=${2:?--mount needs a path}; shift ;;
    --name) NAME=${2:?--name needs a name}; shift ;;
    --root) DEV_ROOT=${2:?--root needs a path}; shift ;;
    --no-build) BUILD_IT=0 ;;
    --zip) ZIP=${2:?--zip needs a path}; BUILD_IT=0; shift ;;
    -h | --help) usage; exit 0 ;;
    *) echo "kindle-dev: unknown option $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

command -v python3 >/dev/null 2>&1 || { echo "kindle-dev: needs python3" >&2; exit 1; }
command -v make >/dev/null 2>&1 || { echo "kindle-dev: needs make" >&2; exit 1; }

# Values that end up in a shell line or a path in the launcher.
python3 -I - "$NAME" "$DEV_ROOT" <<'PY' || exit 2
import re
import sys

name, root = sys.argv[1], sys.argv[2]
if not name or "/" in name or name.startswith(".") or any(c in name for c in "\r\n\t"):
    raise SystemExit("kindle-dev: --name must be a single path-free name")
if not re.fullmatch(r"/[A-Za-z0-9._/-]+", root) or root.endswith("/"):
    raise SystemExit("kindle-dev: --root must be an absolute path with letters, digits, . _ - or /")
PY

mount_docs() {
    for cand in "$1" "$1"/* "$1"/*/*; do
        if [ -d "$cand/documents" ]; then printf '%s\n' "$cand"; return 0; fi
    done
    return 1
}

find_mount() {
    for root in \
        "${MOUNT:-}" \
        "/run/user/$(id -u)"/gvfs/mtp* \
        "/run/media/$(id -un)"/Kindle* \
        "/run/media/$(id -un)"/KINDLE* \
        "/media/$(id -un)"/Kindle* \
        "/media/$(id -un)"/KINDLE* \
        /mnt/kindle; do
        [ -n "$root" ] || continue
        [ -d "$root" ] || continue
        if found=$(mount_docs "$root"); then printf '%s\n' "$found"; return 0; fi
    done
    return 1
}

DEST=
if [ -n "$MOUNT" ]; then
    DEST=$(mount_docs "$MOUNT") || {
        echo "kindle-dev: $MOUNT does not hold a documents folder." >&2
        exit 1
    }
else
    DEST=$(find_mount) || {
        if command -v gio >/dev/null 2>&1; then
            echo "kindle-dev: asking GVFS to mount the Kindle over MTP"
            gio mount mtp:// >/dev/null 2>&1 || true
            DEST=$(find_mount) || DEST=
        fi
    }
fi
if [ -z "$DEST" ]; then
    if command -v lsusb >/dev/null 2>&1 && lsusb 2>/dev/null | grep -qi 'RNDIS/Ethernet Gadget'; then
        echo "kindle-dev: the Kindle is in USB networking (RNDIS) mode, not USB file transfer (MTP)." >&2
    fi
    cat >&2 <<'EOF'
kindle-dev: no mounted Kindle found over MTP.
  1. On the Scribe, choose USB file transfer (MTP) and unlock it; tap Allow if it asks.
  2. On Linux, open the Kindle once in your file manager, or run: gio mount mtp://
  3. If it is mounted somewhere unusual, pass --mount (the folder holding documents).
EOF
    exit 1
fi
[ -w "$DEST/documents" ] || { echo "kindle-dev: $DEST/documents is not writable." >&2; exit 1; }

if [ "$BUILD_IT" = 1 ]; then
    zig_bin=${ZIG:-zig}
    if ! command -v "$zig_bin" >/dev/null 2>&1 && [ ! -x "$zig_bin" ]; then
        echo "kindle-dev: Zig 0.16.0 is not on PATH." >&2
        echo "kindle-dev: put zig on PATH, or set ZIG to the zig binary itself" >&2
        echo "kindle-dev: (ZIG=/absolute/path/to/zig make dev), not to its folder." >&2
        exit 1
    fi
    cargo zigbuild --help >/dev/null 2>&1 || {
        echo "kindle-dev: cargo-zigbuild is not installed (cargo install cargo-zigbuild --version 0.23.0 --locked)." >&2
        exit 1
    }
    echo "kindle-dev: building the dev installer"
    make -C "$ROOT" package
fi

if [ -z "$ZIP" ]; then
    case "${BUILD:-build}" in
    /*) ZIP=${BUILD}/dist/Grimoire.zip ;;
    *) ZIP=$ROOT/${BUILD:-build}/dist/Grimoire.zip ;;
    esac
fi
[ -f "$ZIP" ] || { echo "kindle-dev: $ZIP is not there (run make package, or drop --no-build)" >&2; exit 1; }

TMP=$(mktemp -d /tmp/grimoire-dev.XXXXXX) || { echo "kindle-dev: could not make a temporary folder" >&2; exit 1; }
TMP_FILE=
cleanup() {
    [ -n "$TMP_FILE" ] && rm -f "$TMP_FILE" 2>/dev/null || true
    rm -rf "$TMP"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

LAUNCHER=$TMP/$NAME.sh
if ! python3 -I - "$ZIP" "$LAUNCHER" "$NAME" "$DEV_ROOT" <<'PY'
import sys
import zipfile

zip_path, out_path, name, dev_root = sys.argv[1:5]
with zipfile.ZipFile(zip_path) as archive:
    data = archive.read("documents/Grimoire.sh")
marker = b"\n__GRIMOIRE_APP_ARCHIVE__\n"
head, sep, tail = data.partition(marker)
if not sep or not head.startswith(b"#!/bin/sh\n# Name: Grimoire\n"):
    raise SystemExit("not a Grimoire installer")
if head.count(b"# Name: Grimoire\n") != 1:
    raise SystemExit("launcher name line is not unique")
needle = b"US=${GRIMOIRE_US:-/mnt/us}\n"
if head.count(needle) != 1:
    raise SystemExit("launcher data-root line is not unique")
head = head.replace(b"# Name: Grimoire\n", b"# Name: " + name.encode() + b"\n", 1)
head = head.replace(needle, b"GRIMOIRE_US=" + dev_root.encode() + b"\nexport GRIMOIRE_US\n" + needle, 1)
with open(out_path, "wb") as out:
    out.write(head + sep + tail)
PY
then
    echo "kindle-dev: could not make a dev launcher from $ZIP." >&2
    exit 1
fi

# The launcher code before the appended archive is the part a syntax check can see.
python3 -I - "$LAUNCHER" "$TMP/head.sh" <<'PY'
import sys

data = open(sys.argv[1], "rb").read()
head = data.partition(b"\n__GRIMOIRE_APP_ARCHIVE__\n")[0]
open(sys.argv[2], "wb").write(head + b"\n")
PY
sh -n "$TMP/head.sh" || { echo "kindle-dev: the generated launcher does not parse" >&2; exit 1; }

is_gvfs_mtp() {
    case "$DEST" in
    */gvfs/mtp:host=*) return 0 ;;
    *) return 1 ;;
    esac
}

# The MTP URI of the same place as the GVFS FUSE path. The FUSE view is read-only for creating
# files, while the GVFS MTP backend behind it writes fine through gio.
gvfs_uri() {
    tail=${DEST#*/gvfs/}
    mount=${tail%%/*}
    rel=${tail#"$mount"}
    host=${mount#mtp:host=}
    python3 -I - "$host" "$rel" "$NAME.sh" <<'PY'
import sys
import urllib.parse

host, rel, name = sys.argv[1:4]
base = "mtp://" + host + "/" + urllib.parse.quote(
    (rel.strip("/") + "/documents/").strip("/") + "/", safe="/")
print(base + urllib.parse.quote(name, safe=""))
PY
}

DEST_FILE=$DEST/documents/$NAME.sh
SIZE=$(wc -c <"$LAUNCHER" | tr -d ' ')
echo "kindle-dev: copying \"$NAME\" to $DEST/documents"
if is_gvfs_mtp; then
    command -v gio >/dev/null 2>&1 || { echo "kindle-dev: gio is needed for a GVFS MTP mount." >&2; exit 1; }
    MTP_FILE=$(gvfs_uri)
    if [ -z "$MTP_FILE" ]; then
        echo "kindle-dev: could not work out the MTP destination for $DEST." >&2
        exit 1
    fi
    # A direct copy replaces the file cleanly; the FUSE path cannot create one at all.
    if ! gio copy "$LAUNCHER" "$MTP_FILE"; then
        gio remove "$MTP_FILE" 2>/dev/null || true
        gio copy "$LAUNCHER" "$MTP_FILE" || { echo "kindle-dev: the MTP copy failed (gio)." >&2; exit 1; }
    fi
    sleep 1
    # Read it back through the MTP backend too: the FUSE view can be stale.
    gio copy "$MTP_FILE" "$TMP/readback" || { echo "kindle-dev: could not read the launcher back over MTP." >&2; exit 1; }
    if ! cmp -s "$LAUNCHER" "$TMP/readback"; then
        echo "kindle-dev: $DEST_FILE does not read back as the built launcher." >&2
        exit 1
    fi
else
    TMP_FILE=$DEST/documents/$NAME.sh.new
    cp "$LAUNCHER" "$TMP_FILE" || { echo "kindle-dev: the MTP copy failed." >&2; exit 1; }
    sync 2>/dev/null || true
    GOT=$(wc -c <"$TMP_FILE" | tr -d ' ')
    if [ "$GOT" != "$SIZE" ]; then
        echo "kindle-dev: the MTP copy is $GOT bytes, wanted $SIZE." >&2
        exit 1
    fi
    if ! mv -f "$TMP_FILE" "$DEST_FILE" 2>/dev/null; then
        cp -f "$TMP_FILE" "$DEST_FILE" || { echo "kindle-dev: could not replace $DEST_FILE." >&2; exit 1; }
        rm -f "$TMP_FILE"
    fi
    if ! cmp -s "$LAUNCHER" "$DEST_FILE"; then
        echo "kindle-dev: $DEST_FILE does not read back as the built launcher." >&2
        exit 1
    fi
fi
TMP_FILE=

echo "kindle-dev: installed \"$NAME\" ($(cat "$ROOT/VERSION" 2>/dev/null || echo dev))."
echo "kindle-dev: close Grimoire (dev) if it is open, then tap \"$NAME\" in the Library."
echo "kindle-dev: its notebooks and settings go to $DEV_ROOT/grimoire; the release is untouched."
