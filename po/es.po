#: rust/src/httpd.rs
msgid "Size"
msgstr "Tamaño"

#: rust/src/httpd.rs
msgid "Fit width"
msgstr "Ajustar al ancho"

#: rust/src/httpd.rs
msgid "Smaller"
msgstr "Más pequeño"

#: rust/src/httpd.rs
msgid "Larger"
