#. TRANSLATORS: under a folder's card in the Library.
#: src/library.c
#, c-format
msgid "%d notebook"
msgid_plural "%d notebooks"
msgstr[0] "%d cuaderno"
msgstr[1] "%d cuadernos"

#. TRANSLATORS: under a notebook's card in the Library: its pages and when it last changed (a
#. date and time, "Oct 10, 14:32"). Sideways the line has 316 px at 34 px; when it is longer,
#. the time is left out.
#: src/library.c
#, c-format
msgid "%d page, %s"
msgid_plural "%d pages, %s"
msgstr[0] "%d página, %s"
msgstr[1] "%d páginas, %s"

#. TRANSLATORS: in Settings > Language, the choice that follows the Kindle's own language, with
#. that language's name (each language is named in itself: "English", "Español").
#: src/library.c
#, c-format
msgid "Automatic (%s)"
msgstr "Automático (%s)"

#. TRANSLATORS: a row of Settings, with the choice: "Automatic (English)", or a language's name.
#: src/library.c
#, c-format
msgid "Language: %s"
msgstr "Idioma: %s"

#: src/library.c
msgid "Cancel"
msgstr "Cancelar"

#. TRANSLATORS: the title of the list of languages (Settings > Language).
#: src/library.c
msgid "Language"
msgstr "Idioma"

#. TRANSLATORS: a new notebook's name until it is renamed, with the day ("Notebook Oct 10").
#: src/library.c
#, c-format
msgid "Notebook %s"
msgstr "Cuaderno %s"

#. TRANSLATORS: months, as short as the language writes them on a date: "Oct 10, 14:32" on the
#. Library's cards, which are narrow when the Kindle is sideways.
#: src/util.c
msgctxt "month"
msgid "Jan"
msgstr "ene"

#: src/util.c
msgctxt "month"
msgid "Feb"
msgstr "feb"

#: src/util.c
msgctxt "month"
msgid "Mar"
msgstr "mar"

#: src/util.c
msgctxt "month"
msgid "Apr"
msgstr "abr"

#: src/util.c
msgctxt "month"
msgid "May"
msgstr "may"

#: src/util.c
msgctxt "month"
msgid "Jun"
msgstr "jun"

#: src/util.c
msgctxt "month"
msgid "Jul"
msgstr "jul"

#: src/util.c
msgctxt "month"
msgid "Aug"
msgstr "ago"

#: src/util.c
msgctxt "month"
msgid "Sep"
msgstr "sept"

#: src/util.c
msgctxt "month"
msgid "Oct"
msgstr "oct"

#: src/util.c
msgctxt "month"
msgid "Nov"
msgstr "nov"

#: src/util.c
msgctxt "month"
msgid "Dec"
msgstr "dic"

#. TRANSLATORS: a date and time, "Oct 10, 14:32": the month (as above), the day, then hours and
#. minutes on the 24-hour clock. Reorder them with %1$s, %2$d, %3$02d and %4$02d ("%2$d %1$s,
#. %3$02d:%4$02d" is "10 Oct, 14:32"), using that form for all four.
#: src/util.c
#, c-format
msgctxt "date"
msgid "%s %d, %02d:%02d"
msgstr "%2$d %1$s, %3$02d:%4$02d"

#. TRANSLATORS: a date, "Oct 10", in a new notebook's name ("Notebook Oct 10"): the month (as
#. above), then the day. "%2$d %1$s" is "10 Oct".
#: src/util.c
#, c-format
msgctxt "date"
msgid "%s %d"
msgstr "%2$d %1$s"
