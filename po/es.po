#. TRANSLATORS: the name of a notebook that has none (it is saved with it, as a name given).
#: src/annotate.c src/store.c src/ui.c
msgid "Untitled"
msgstr "Sin título"

#. TRANSLATORS: notices when Grimoire opens from KOReader's "Annotate this page in Grimoire"
#. and that page cannot be opened, in a toast: one line of about 1700 px at 44 px in bold, or
#. two. This one: the picture of the page KOReader sent is damaged or missing.
#: src/app.c
msgid "Could not open the page KOReader sent: its picture does not read."
msgstr ""
"No se pudo abrir la página que envió KOReader: no se puede leer su imagen."

#. TRANSLATORS: (as above) the page could not be added to its notebook: a file could not be
#. written.
#: src/app.c
msgid "Could not add the page KOReader sent. Is the storage full?"
msgstr ""
"No se pudo añadir la página que envió KOReader. ¿Está lleno el "
"almacenamiento?"

#. TRANSLATORS: (as above) any other reason; %s is the log file that says why.
#: src/app.c
#, c-format
msgid "Could not open the page KOReader sent (see %s)."
msgstr "No se pudo abrir la página que envió KOReader (detalles en %s)."

#. TRANSLATORS: notices when Grimoire opens from KOReader's "Open this book in Grimoire", in a
#. toast: one line of about 1700 px at 44 px in bold, or two. This one: the book has more pages
#. than a notebook holds; %d is that number (2000).
#: src/app.c
#, c-format
msgid "The book has more pages than a notebook holds (%d)."
msgstr "El libro tiene más páginas de las que caben en un cuaderno (%d)."

#. TRANSLATORS: (as above) a page picture KOReader made is damaged or missing.
#: src/app.c
msgid "Could not open the book KOReader sent: a page's picture does not read."
msgstr ""
"No se pudo abrir el libro que envió KOReader: no se puede leer la imagen de "
"una página."

#. TRANSLATORS: (as above) the pages could not be added: a file could not be written.
#: src/app.c
msgid "Could not add the book's pages. Is the storage full?"
msgstr ""
"No se pudieron añadir las páginas del libro. ¿Está lleno el almacenamiento?"

#. TRANSLATORS: (as above) any other reason; %s is the log file that says why.
#: src/app.c
#, c-format
msgid "Could not open the book KOReader sent (see %s)."
msgstr "No se pudo abrir el libro que envió KOReader (detalles en %s)."

#. TRANSLATORS: in a toast, once the pages of a book KOReader sent are in its notebook.
#: src/app.c
#, c-format
msgid "Added %d page of the book."
msgid_plural "Added %d pages of the book."
msgstr[0] "Se añadió %d página del libro."
msgstr[1] "Se añadieron %d páginas del libro."

#. TRANSLATORS: in a toast while Grimoire puts the pages of a book KOReader sent into its
#. notebook (a few seconds for a big book): pages done, of how many. One line of about 1700 px.
#: src/app.c
#, c-format
msgid "Adding the book's pages: %d of %d"
msgstr "Añadiendo las páginas del libro: %d de %d"

#. TRANSLATORS: notices at startup, in a toast: one line of about 1700 px at 44 px in bold,
#. or two. "Kindle Settings" is the Kindle's own Settings, as its menus name them.
#: src/app.c
msgid "Your Kindle passcode was left off. Turn it back on in Kindle Settings."
msgstr ""
"La contraseña del Kindle quedó desactivada. Vuelve a activarla en la "
"Configuración del Kindle."

#. TRANSLATORS: %s is the app's name, Grimoire.
#: src/app.c
#, c-format
msgid "No pen found. %s is made for the Kindle Scribe; writing needs its pen."
msgstr ""
"No se encontró el lápiz. %s está hecho para el Kindle Scribe; para escribir "
"hace falta su lápiz."

#. TRANSLATORS: holding the power button 4 s leaves Grimoire, but this page could not be
#. saved (a full storage), so it stays once.
#: src/app.c
msgid "Could not save this page. Hold power 4 s again to leave anyway."
msgstr ""
"No se pudo guardar esta página. Vuelve a mantener presionado el botón de "
"encendido 4 s para salir de todos modos."

#. TRANSLATORS: the last notice before Grimoire closes, with the page saved, or without it;
#. %s is the app's name, Grimoire.
#: src/app.c
#, c-format
msgid "Saved. Leaving %s."
msgstr "Guardado. Saliendo de %s."

#: src/app.c
#, c-format
msgid "Leaving %s without this page."
msgstr "Saliendo de %s sin guardar esta página."

#. TRANSLATORS: a folder of page pictures (grimoire/import/<name>) became a new notebook.
#: src/app.c
#, c-format
msgid "Imported a notebook of %d page."
msgid_plural "Imported a notebook of %d pages."
msgstr[0] "Se importó un cuaderno de %d página."
msgstr[1] "Se importó un cuaderno de %d páginas."

#. TRANSLATORS: a folder of page pictures could not become a notebook; %s is the log file
#. that says why. The folder stays where it was.
#: src/app.c
#, c-format
msgid "Could not import a folder of pages (see %s)."
msgstr "No se pudo importar una carpeta de páginas (detalles en %s)."

#. TRANSLATORS: a PDF saved in the background, and where (the Kindle's folder of them).
#: src/app.c
#, c-format
msgid "PDF saved to %s"
msgstr "PDF guardado en %s"

#: src/app.c
msgid "Could not save the PDF"
msgstr "No se pudo guardar el PDF"

#. TRANSLATORS: a page that could not be read; %s is the log file that says which.
#: src/app.c
#, c-format
msgid "A damaged page was set aside; a blank one took its place (see %s)"
msgstr ""
"Se apartó una página dañada y una en blanco ocupa su lugar (detalles en %s)"

#: src/bgwork_template.c
msgid "Templates for Grimoire"
msgstr "Plantillas para Grimoire"

#: src/bgwork_template.c
msgid ""
"Copy pictures here to write on them as paper: PNG or JPG files, upright, in "
"the shape of a Kindle Scribe page (3:4). 1860 x 2480 pixels is best. Light "
"lines on white work best on e-ink: dark areas hide your writing."
msgstr ""
"Copia aquí imágenes para escribir sobre ellas como papel: archivos PNG o "
"JPG, en vertical, con la forma de una página del Kindle Scribe (3:4). Lo "
"ideal es 1860 x 2480 píxeles. En una pantalla de tinta electrónica funcionan "
"mejor las líneas claras sobre blanco: las zonas oscuras ocultan lo que "
"escribes."

#: src/bgwork_template.c
msgid ""
"Copy them in over USB while Grimoire is closed. A notebook keeps its own "
"copy of each template it uses, so changing or deleting a file here never "
"changes pages already written on it. Grimoire keeps its previews of these "
"files in the .cache folder."
msgstr ""
"Cópialas por USB con Grimoire cerrado. Cada cuaderno guarda su propia copia "
"de cada plantilla que usa, así que cambiar o borrar un archivo de aquí nunca "
"cambia las páginas ya escritas sobre ella. Grimoire guarda en la "
"carpeta .cache sus vistas previas de estos archivos."

#: src/bgwork_template.c
msgid "Importing pages into Grimoire"
msgstr "Importar páginas a Grimoire"

#: src/bgwork_template.c
msgid ""
"To write on pages you already have, such as a PDF saved as pictures, put a "
"folder of PNG or JPG files here, one picture a page, and start Grimoire. The "
"folder's name becomes the notebook's name, and the pages follow the file "
"names in order (page-2 comes before page-10). Gray pictures import faster "
"and take less room than colour ones."
msgstr ""
"Para escribir sobre páginas que ya tienes, como un PDF guardado como "
"imágenes, pon aquí una carpeta de archivos PNG o JPG, una imagen por página, "
"y abre Grimoire. El nombre de la carpeta será el nombre del cuaderno, y las "
"páginas siguen el orden de los nombres de archivo (page-2 va antes de "
"page-10). Las imágenes en gris se importan más rápido y ocupan menos espacio "
"que las de color."

#: src/bgwork_template.c
msgid ""
"Grimoire imports each folder in the background and then moves it into the "
"done folder. Copy folders in over USB while Grimoire is closed."
msgstr ""
"Grimoire importa cada carpeta en segundo plano y después la mueve a la "
"carpeta done. Copia las carpetas por USB con Grimoire cerrado."

