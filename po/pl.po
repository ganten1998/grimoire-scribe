msgid "Graph"
msgstr "Graf"

#: rust/src/actions.rs
msgid "Pan with the pen"
msgstr "Przesuwaj rysikiem"

#: rust/src/actions.rs
msgid "Zoom with the pen"
msgstr "Powiększaj rysikiem"

#. TRANSLATORS: (Buttons sheet) Select mode on or off: the pen draws a lasso around ink to copy, cut,
#. paste or move it.
#: rust/src/actions.rs
msgid "Select (lasso)"
msgstr "Zaznacz (lasso)"

#. TRANSLATORS: (Gestures and shortcuts lists, about 1100 px at 44 px in bold) Select mode with a lasso
#. that cuts strokes along its line (exact area); with Select mode on, it switches between whole
#. strokes and exact area.
#: rust/src/actions.rs
msgid "Select exact area"
msgstr "Dokładny obszar"

#. TRANSLATORS: (Gestures and shortcuts lists, about 1100 px at 44 px in bold) opens the count pad that
#. adds several blank pages at once after the open page, which stays open.
#: rust/src/actions.rs
msgid "New pages..."
msgstr "Nowe strony..."

#. TRANSLATORS: (the keyboard shortcuts lists, about 1100 px at 44 px in bold) Ctrl+S: the open page and
#. its notebook written now (in the Library, any setting waiting).
#: rust/src/actions.rs
msgid "Save now"
msgstr "Zapisz teraz"

#. TRANSLATORS: (the keyboard shortcuts lists, about 1100 px at 44 px in bold) Esc: what is in front closes
#. (a dialog, a menu, a selection), else back to the Library, and there "Exit Grimoire?".
#: rust/src/actions.rs
msgid "Back or close"
msgstr "Wstecz lub zamknij"

#. TRANSLATORS: (the keyboard shortcuts lists, about 1100 px at 44 px in bold) Space on a page: does what
#. two fingers swiped up do (at first, the Links bar). (No gesture does it: it is a gesture's own.)
#: rust/src/actions.rs
msgid "What two fingers up do"
msgstr "Co robią dwa palce w górę"

#. TRANSLATORS: (the keyboard shortcuts lists, about 1100 px at 44 px in bold) Ctrl+N in the Library: the
#. New notebook sheet, as the top bar's New button.
#. TRANSLATORS: the title of the sheet that makes a notebook, and its heading over the papers.
#: rust/src/actions.rs rust/src/library.rs
msgid "New notebook"
msgstr "Nowy notatnik"

#. TRANSLATORS: (the keyboard shortcuts lists, about 1100 px at 44 px in bold) Ctrl+F in the Library: a new
#. folder's name keyboard, as the top bar's Folder button.
#: rust/src/actions.rs
msgid "New folder"
msgstr "Nowy folder"

#. TRANSLATORS: (the keyboard shortcuts lists, about 1100 px at 44 px in bold) S in the Library: the
#. Share screen, as the top bar's Share button.
#: rust/src/actions.rs rust/src/library.rs
msgid "Share"
msgstr "Udostępnij"

#. TRANSLATORS: (the keyboard shortcuts lists, about 1100 px at 44 px in bold) O in the Library: the
#. Settings sheet, as the top bar's Settings button.
#: rust/src/actions.rs rust/src/library.rs
msgid "Settings"
msgstr "Ustawienia"

#. TRANSLATORS: (the Keyboard shortcuts list, about 1100 px at 44 px in bold) ticks every page in the Pages
#. view (and selects every node in the Graph): the same words as the Pages view's Select all button.
#: rust/src/actions.rs rust/src/pagesview.rs
msgid "Select all"
msgstr "Zaznacz wszystko"

#. TRANSLATORS: (shortcuts lists, about 1100 px at 44 px in bold) in the Graph, its view button's action:
#. View: All and View: Adjacent in turn (all notebooks' pages, or the pages around one).
#: rust/src/actions.rs
msgid "Graph view: All or Adjacent"
msgstr "Widok grafu: wszystko lub sąsiednie"

#. TRANSLATORS: (shortcuts lists, about 1100 px at 44 px in bold) in the Graph, the left arrow: the view moves
#. left (the map slides the other way). Right, up and down follow.
#: rust/src/actions.rs
msgid "Move the Graph left"
msgstr "Przesuń graf w lewo"

#. TRANSLATORS: (shortcuts lists, about 1100 px at 44 px in bold) in the Graph, the right arrow: the view moves
#. right (the map slides the other way).
#: rust/src/actions.rs
msgid "Move the Graph right"
msgstr "Przesuń graf w prawo"

#. TRANSLATORS: (shortcuts lists, about 1100 px at 44 px in bold) in the Graph, the up arrow: the view moves
#. up (the map slides the other way).
#: rust/src/actions.rs
msgid "Move the Graph up"
msgstr "Przesuń graf w górę"

#. TRANSLATORS: (shortcuts lists, about 1100 px at 44 px in bold) in the Graph, the down arrow: the view moves
#. down (the map slides the other way).
#: rust/src/actions.rs
msgid "Move the Graph down"
msgstr "Przesuń graf w dół"

#. TRANSLATORS: (Gestures and shortcuts lists, about 1100 px at 44 px in bold) the pen in use goes to the next
#. smaller of its five quick sizes (the widths of the card a pen held on the toolbar opens).
#: rust/src/actions.rs
msgid "Smaller size"
msgstr "Mniejszy rozmiar"

#. TRANSLATORS: (Gestures and shortcuts lists, about 1100 px at 44 px in bold) the pen in use goes to the next
#. larger of its five quick sizes.
#: rust/src/actions.rs
msgid "Larger size"
msgstr "Większy rozmiar"

#. TRANSLATORS: (Gestures and shortcuts lists, about 1100 px at 44 px in bold) opens the card of the pen in
#. use's quick sizes beside its button on the toolbar, as holding that button does.
#: rust/src/actions.rs
msgid "Sizes of the pen in use"
msgstr "Rozmiary używanego rysika"

#. TRANSLATORS: (shortcuts and gestures lists, about 1100 px at 44 px in bold) in the Library: opens Files, the
#. Kindle's storage to browse, whether or not its card is in the Library.
#. TRANSLATORS: the file picker's name, the first word of its path line (small, in a band of 100 px).
#: rust/src/actions.rs rust/src/browser.rs rust/src/library.rs
msgid "Files"
msgstr "Pliki"

#. TRANSLATORS: (shortcuts and gestures lists, about 1100 px at 44 px in bold) in the Library: back to its top,
#. out of any folder (and out of Files).
#: rust/src/actions.rs
msgid "Home"
msgstr "Początek"

#. TRANSLATORS: the name of a notebook that has none (it is saved with it, as a name given).
#: rust/src/annotate.rs rust/src/pdfimport.rs rust/src/store.rs rust/src/ui.rs
msgid "Untitled"
msgstr "Bez tytułu"

#. TRANSLATORS: notices when Grimoire opens from KOReader's "Annotate this page in Grimoire"
#. and that page cannot be opened, in a toast: one line of about 1700 px at 44 px in bold, or
#. two. This one: the picture of the page KOReader sent is damaged or missing.
#: rust/src/app.rs
msgid "Couldn't open page: its image is unreadable."
msgstr "Nie można otworzyć strony: jej obraz jest nieczytelny."

#. TRANSLATORS: (as above) the page could not be added to its notebook: a file could not be
#. written.
#: rust/src/app.rs
msgid "Couldn't add page from KOReader. Is the storage full?"
msgstr "Nie można dodać strony z KOReadera. Czy pamięć jest pełna?"

#. TRANSLATORS: (as above) any other reason; %s is the log file that says why.
#: rust/src/app.rs
#, c-format
msgid "Couldn't open page from KOReader (see %s)."
msgstr "Nie można otworzyć strony z KOReadera (zob. %s)."

#. TRANSLATORS: notices when Grimoire opens from KOReader's "Open this book in Grimoire", in a
#. toast: one line of about 1700 px at 44 px in bold, or two. This one: the book has more pages
#. than a notebook holds; %d is that number (2000).
#: rust/src/app.rs
#, c-format
msgid "Book too long: notebooks hold %d pages."
msgstr "Książka za długa: notatnik mieści %d stron."

#. TRANSLATORS: (as above) a page picture KOReader made is damaged or missing.
#: rust/src/app.rs
msgid "Couldn't open book: a page image is unreadable."
msgstr "Nie można otworzyć książki: obraz strony jest nieczytelny."

#. TRANSLATORS: (as above) the pages could not be added: a file could not be written.
#: rust/src/app.rs
msgid "Couldn't add book pages. Is the storage full?"
msgstr "Nie można dodać stron książki. Czy pamięć jest pełna?"

#. TRANSLATORS: (as above) any other reason; %s is the log file that says why.
#: rust/src/app.rs
#, c-format
msgid "Couldn't open book from KOReader (see %s)."
msgstr "Nie można otworzyć książki z KOReadera (zob. %s)."

#. TRANSLATORS: in a toast, once the pages of a book KOReader sent are in its notebook, but some of
#. the book's links (a planner's tabs) are not: there were too many, or they could not be saved.
#: rust/src/app.rs
#, c-format
msgid "Added %d book page. Some links were left out."
msgid_plural "Added %d book pages. Some links were left out."
msgstr[0] "Dodano %d stronę książki. Pominięto część odnośników."
msgstr[1] "Dodano %d strony książki. Pominięto część odnośników."
msgstr[2] "Dodano %d stron książki. Pominięto część odnośników."

#. TRANSLATORS: in a toast, once the pages of a book KOReader sent are in its notebook.
#: rust/src/app.rs
#, c-format
msgid "Added %d book page."
msgid_plural "Added %d book pages."
msgstr[0] "Dodano %d stronę książki."
msgstr[1] "Dodano %d strony książki."
msgstr[2] "Dodano %d stron książki."

#. TRANSLATORS: in a toast, once a book KOReader sent opened in its notebook with no new pages: some of
#. the book's links (a planner's tabs) are not in it, as there were too many, or they could not be saved.
#: rust/src/app.rs
msgid "Some links were left out."
msgstr "Pominięto część odnośników."

#. TRANSLATORS: in a toast while Grimoire puts the pages of a book KOReader sent into its
#. notebook (a few seconds for a big book): pages done, of how many. One line of about 1700 px.
#: rust/src/app.rs rust/src/editor.rs
#, c-format
msgid "Adding book pages: %d of %d"
msgstr "Dodawanie stron książki: %d z %d"

#. TRANSLATORS: a toast at the start after an update KPM could not install (Settings > Updates).
#: rust/src/app.rs
msgid "Last update failed. See grimoire.log."
msgstr "Ostatnia aktualizacja nieudana. Zob. grimoire.log."

#. TRANSLATORS: %s is the app's name, Grimoire.
#: rust/src/app.rs
#, c-format
msgid "No pen found. %s is made for Kindle Scribe; writing needs its pen."
msgstr ""
"Nie znaleziono rysika. %s jest przeznaczony na Kindle Scribe; pisanie "
"wymaga rysika."

#. TRANSLATORS: toasts (one line of about 1700 px at 44 px in bold) when a controller, keyboard
#. or page turner comes or goes. "In use by another app": another program (a button mapper)
#. takes its presses, so Grimoire gets none.
#: rust/src/app.rs
msgid "Controller disconnected"
msgstr "Kontroler rozłączony"

#: rust/src/app.rs
msgid "Controller in use by another app"
msgstr "Kontroler zajęty przez inną aplikację"

#: rust/src/app.rs
msgid "Controller connected"
msgstr "Kontroler połączony"

#. TRANSLATORS: a toast: Live view could not start (no memory for its copy of the screen,
#. or the server's port is taken).
#: rust/src/app.rs
msgid "Couldn't start Live view"
msgstr "Nie można uruchomić podglądu na żywo"

#. TRANSLATORS: a toast as Live view stops (the Stop button on its card).
#: rust/src/app.rs
msgid "Live view ended."
msgstr "Podgląd na żywo zakończony."

#. TRANSLATORS: a toast: Live view turned itself off after 10 minutes with nobody watching.
#: rust/src/app.rs
msgid "Live view off: no viewers for 10 minutes."
msgstr "Podgląd na żywo wyłączony: brak widzów przez 10 minut."

#. TRANSLATORS: a toast as the first computer starts watching the screen (Live view).
#: rust/src/app.rs
msgid "A computer is watching this screen."
msgstr "Komputer obserwuje ten ekran."

#. TRANSLATORS: holding the power button 4 s leaves Grimoire, but this page could not be
#. saved (a full storage), so it stays once.
#: rust/src/app.rs
msgid "Couldn't save page. Hold power 4 s again to leave anyway."
msgstr ""
